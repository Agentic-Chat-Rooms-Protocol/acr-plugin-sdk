{
  "schema_version": "1.0.0",
  "id": "hello-consensus",
  "name": "Hello Consensus Plugin",
  "version": "1.0.1",
  "author": "@acr-js",
  "description": "Demonstration plugin verifying 67% consensus voting, room messaging, and dissent reporting",
  "category": "governance",
  "entrypoint": "index.ts",
  "permissions_required": [
    "consensus.vote",
    "mcp.tools.execute"
  ],
  "tools": [
    "acr_room_consensus",
    "acr_room_send",
    "hello_consensus_ping"
  ],
  "workflows": [
    "bft-consensus-deliberation"
  ],
  "oauth_scopes": [
    "profile",
    "email"
  ],
  "config_schema": [
    {
      "key": "greeting_prefix",
      "label": "Greeting Prefix",
      "type": "string",
      "defaultValue": "Hello from Consensus",
      "description": "Prefix text for consensus status responses"
    }
  ],
  "repository_url": "https://github.com/Agentic-Chat-Rooms-Protocol/acr-plugin-sdk",
  "license": "Apache-2.0"
}
